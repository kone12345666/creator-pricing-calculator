FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts/patch-vinext-windows.mjs ./scripts/patch-vinext-windows.mjs
RUN npm ci
COPY . .

# Browsers use this same-origin proxy. The sync container is never reachable
# from a browser or from the server's public network interface.
ARG NEXT_PUBLIC_SYNC_ROOT=/api/sync
ENV NEXT_PUBLIC_SYNC_ROOT=${NEXT_PUBLIC_SYNC_ROOT}
RUN npm run build

FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app /app
EXPOSE 3103 3001

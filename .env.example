# 本地配置文件：复制本文件为 `.env` 后填写真实值。不要提交 `.env`。
#
# 仅本机访问：DEV_HOST=127.0.0.1，SYNC_HOST=127.0.0.1
# 局域网访问：DEV_HOST=0.0.0.0，SYNC_HOST=0.0.0.0（并放行防火墙 3000/3001）

# Page dev server (Vite / vinext)
DEV_HOST=0.0.0.0
DEV_PORT=3000

# Frontend: where the browser calls the sync helper.
# Local dev (open http://localhost:3000):
NEXT_PUBLIC_SYNC_ROOT=http://localhost:3001
# LAN dev (open http://192.168.x.x:3000) — must match SYNC_HOST=0.0.0.0 below:
# NEXT_PUBLIC_SYNC_ROOT=http://192.168.1.157:3001

# Sync helper network settings.
# 127.0.0.1 = only this computer; 0.0.0.0 = also reachable via LAN IP
SYNC_HOST=0.0.0.0
SYNC_PORT=3001
# Must include every URL you use to open the page (comma-separated)
SYNC_ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.157:3000

# Existing Feishu Bitable configuration. Do not commit real values.
FEISHU_BASE_TOKEN=
FEISHU_PROJECT_TABLE_ID=
FEISHU_CREATOR_TABLE_ID=
FEISHU_BASE_URL=

# Company self-built application used by this project. App ID is not a secret;
# App Secret must be stored only in the deployment platform's secret manager.
FEISHU_APP_ID=cli_aafafde807f8dd14

# Transitional local implementation: lark-cli application profile, identity and executable path.
# Keep the App Secret in lark-cli/keychain. Do not write it into this file.
# Profile name from: lark-cli config show
LARK_PROFILE=cli_aafafde807f8dd14
LARK_IDENTITY=bot
LARK_CLI_PATH=
